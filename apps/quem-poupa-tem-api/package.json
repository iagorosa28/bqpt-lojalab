{
  "name": "quem-poupa-tem-api",
  "version": "0.1.0",
  "private": true,
  "description": "API do Banco Quem Poupa Tem",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --env-file-if-exists=.env.test ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=.env.test ./node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
